local function clearOptions()
    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("GuiObject") and child ~= nil
            and not child:IsA("UIListLayout")
            and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end
end

local function addLabel(text, detail)
    local row = make("Frame", {
        Size = UDim2.new(1, -4, 0, detail and 53 or 38),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
    }, scroll)
    corner(row, 5)

    make("TextLabel", {
        Position = UDim2.new(0, 10, 0, detail and 5 or 0),
        Size = UDim2.new(1, -20, 0, detail and 22 or 38),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = C.text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    if detail then
        make("TextLabel", {
            Position = UDim2.new(0, 10, 0, 27),
            Size = UDim2.new(1, -20, 0, 18),
            BackgroundTransparency = 1,
            Text = detail,
            TextColor3 = C.muted,
            TextSize = 10,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
    end
    return row
end

local function addToggle(label, initial, callback)
    local row = make("Frame", {
        Size = UDim2.new(1, -4, 0, 40),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
    }, scroll)
    corner(row, 5)

    make("TextLabel", {
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -65, 1, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = C.text,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local on = initial == true
    local toggle = make("TextButton", {
        Position = UDim2.new(1, -49, 0.5, -10),
        Size = UDim2.new(0, 39, 0, 20),
        BackgroundColor3 = on and C.green or C.item,
        Text = on and "ON" or "OFF",
        TextColor3 = C.text,
        TextSize = 9,
        Font = Enum.Font.GothamBold,
        BorderSizePixel = 0,
    }, row)
    corner(toggle, 5)

    toggle.Activated:Connect(function()
        on = not on
        toggle.Text = on and "ON" or "OFF"
        toggle.BackgroundColor3 = on and C.green or C.item
        if callback then callback(on) end
    end)
    return row
end

local function addButton(label, callback)
    local btn = make("TextButton", {
        Size = UDim2.new(1, -4, 0, 42),
        BackgroundColor3 = C.item,
        BorderSizePixel = 0,
        Text = label,
        TextColor3 = C.text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = true,
    }, scroll)
    corner(btn, 5)
    stroke(btn, C.gold, 0.82)
    btn.Activated:Connect(callback or function() end)
    return btn
end

local tabs = {
    "Tab Shop",
    "Tab Status And Server",
    "Tab Local Player",
    "Setting Farm",
    "Setting Hold and Select Skill",
    "Tab Farming",
    "Tab Stack Farm",
}

local selectedTab
local buttons = {}

local function renderTab(tab)
    selectedTab = tab
    heading.Text = tab
    clearOptions()

    for name, button in pairs(buttons) do
        button.BackgroundColor3 =
            name == tab and Color3.fromRGB(48, 62, 76) or C.item
    end

    if tab == "Tab Status And Server" then
        addLabel("Time", "Elapsed session time: " ..
            os.date("%H:%M:%S"))
        addToggle("Elite Mob", false, function(on)
            print("Elite Mob demo toggle:", on)
        end)
        addButton("Summon Katakuri", function()
            addLabel("Notice", "Demo button clicked")
        end)
        addLabel("Status SPY", "Demo status: Ready")
        addLabel("Server Status", "Connected to this game session")
        addButton("Refresh Status", function()
            renderTab("Tab Status And Server")
        end)

    elseif tab == "Tab Shop" then
        addLabel("Shop", "Interface demonstration")
        addButton("Open Shop Panel", function()
            addLabel("Shop", "Connect your own shop system here")
        end)
        addButton("Refresh Shop", function()
            renderTab("Tab Shop")
        end)

    elseif tab == "Tab Local Player" then
        addLabel("Local Player", player.Name)
        addToggle("Show Player Info", true, function(on)
            print("Show Player Info:", on)
        end)
        addToggle("WalkSpeed Demo", false, function(on)
            print("WalkSpeed demo toggle:", on)
        end)
        addButton("Show Character Status", function()
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            addLabel("Character", hum and
                ("Health: " .. math.floor(hum.Health)) or "Character not loaded")
        end)

    elseif tab == "Setting Farm" then
        addLabel("Farm Settings", "Configure demo options")
        addToggle("Enable Farm UI", false)
        addToggle("Show Quest Info", true)
        addToggle("Show Mob Counter", true)
        addButton("Reset Farm Settings", function()
            renderTab("Setting Farm")
        end)

    elseif tab == "Setting Hold and Select Skill" then
        addLabel("Hold and Select Skill", "UI settings")
        for _, skill in ipairs({"Skill Z", "Skill X", "Skill C", "Skill V"}) do
            addToggle("Enable " .. skill, false, function(on)
                print(skill, on)
            end)
        end

    elseif tab == "Tab Farming" then
        addLabel("Farming", "Private game UI demo")
        addToggle("Enable Farming Panel", false)
        addToggle("Show Progress", true)
        addButton("Start Demo", function()
            addLabel("Demo", "Button activated successfully")
        end)
        addButton("Stop Demo", function()
            addLabel("Demo", "Demo stopped")
        end)

    elseif tab == "Tab Stack Farm" then
        addLabel("Stack Farm", "Private game UI demo")
        addToggle("Enable Stack Panel", false)
        addButton("Start Stack Demo", function()
            addLabel("Stack", "Demo started")
        end)
        addButton("Reset Stack Demo", function()
            renderTab("Tab Stack Farm")
        end)
    end
end

for i, tab in ipairs(tabs) do
    local btn = make("TextButton", {
        Name = "Tab" .. i,
        LayoutOrder = i,
        Size = UDim2.new(1, 0, 0, 36),
