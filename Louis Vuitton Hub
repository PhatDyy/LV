local function newPage(name)
    local page = create("ScrollingFrame", {
        Name = name,
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = GOLD,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false
    }, pages)

    create("UICorner", {CornerRadius = UDim.new(0, 9)}, page)
    create("UIPadding", {
        PaddingTop = UDim.new(0, 12),
        PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12)
    }, page)

    create("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, page)

    pageFrames[name] = page
    return page
end

local function heading(parent, text)
    return create("TextLabel", {
        Size = UDim2.new(1, -4, 0, 28),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = GOLD,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left
    }, parent)
end

local function label(parent, text, height)
    return create("TextLabel", {
        Size = UDim2.new(1, -4, 0, height or 32),
        BackgroundColor3 = DARK,
        BorderSizePixel = 0,
        Text = "  " .. text,
        TextColor3 = WHITE,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left
    }, parent)
end

local function button(parent, text, callback)
    local b = create("TextButton", {
        Size = UDim2.new(1, -4, 0, 35),
        BackgroundColor3 = DARK,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = WHITE,
        Font = Enum.Font.GothamSemibold,
        TextSize = 12,
        AutoButtonColor = false
    }, parent)

    create("UICorner", {CornerRadius = UDim.new(0, 7)}, b)
    create("UIStroke", {Color = Color3.fromRGB(65, 60, 48), Thickness = 1}, b)

    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {
            BackgroundColor3 = Color3.fromRGB(52, 45, 30)
        }):Play()
    end)

    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {
            BackgroundColor3 = DARK
        }):Play()
    end)

    b.Activated:Connect(callback)
    return b
end

local function switchPage(name)
    for pageName, page in pairs(pageFrames) do
        page.Visible = pageName == name
    end

    for tabName, tab in pairs(tabButtons) do
        tab.BackgroundColor3 = tabName == name and
            Color3.fromRGB(68, 53, 25) or DARK
        tab.TextColor3 = tabName == name and GOLD or WHITE
    end
end

for i, name in ipairs(pageNames) do
    local page = newPage(name)

    local tab = create("TextButton", {
        Position = UDim2.new(0, 7, 0, 8 + (i - 1) * 43),
        Size = UDim2.new(1, -14, 0, 35),
        BackgroundColor3 = DARK,
        BorderSizePixel = 0,
        Text = "  " .. name,
        TextColor3 = WHITE,
        Font = Enum.Font.GothamSemibold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, sidebar)

    create("UICorner", {CornerRadius = UDim.new(0, 7)}, tab)
    tabButtons[name] = tab
    tab.Activated:Connect(function()
        switchPage(name)
    end)
end

-- DASHBOARD
do
    local p = pageFrames["Dashboard"]
    heading(p, "WELCOME BACK")
    label(p, "Player: " .. player.Name)
    local level = label(p, "Level: loading...")
    local health = label(p, "Health: loading...")
    local position = label(p, "Position: loading...")
    local status = label(p, "Status: Hub ready", 42)

    button(p, "Refresh Character Info", function()
        local ls = player:FindFirstChild("leaderstats")
        local lv = ls and (ls:FindFirstChild("Level") or ls:FindFirstChild("Lv"))
        level.Text = "  Level: " .. (lv and tostring(lv.Value) or "Not available")

        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        health.Text = hum and string.format(
            "  Health: %.0f / %.0f", hum.Health, hum.MaxHealth
        ) or "  Health: character unavailable"

        local root = char and char:FindFirstChild("HumanoidRootPart")
        position.Text = root and string.format(
            "  Position: %.0f, %.0f, %.0f",
            root.Position.X, root.Position.Y, root.Position.Z
        ) or "  Position: unavailable"

        status.Text = "  Status: Information refreshed"
    end)

    button(p, "Show / Hide Hub", function()
        main.Visible = not main.Visible
    end)
end

-- FARM GUIDE
do
    local p = pageFrames["Farm Guide"]
    heading(p, "FARM PROGRESS CHECKLIST")
    label(p, "Checklist only: it does not automate actions in public Blox Fruits.")

    for taskName in pairs(checklist) do
        button(p, (checklist[taskName] and "[DONE] " or "[TODO] ") .. taskName,
            function()
                checklist[taskName] = not checklist[taskName]
                -- Refresh this tab to update checklist labels.
                switchPage("Dashboard")
                switchPage("Farm Guide")
            end)
    end

    button(p, "Reset Checklist", function()
        for taskName in pairs(checklist) do
            checklist[taskName] = false
        end
        switchPage("Dashboard")
        switchPage("Farm Guide")
    end)
end

-- ITEMS
