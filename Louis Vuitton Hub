        Text = tab,
        TextColor3 = C.text,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        TextWrapped = true,
        AutoButtonColor = true,
    }, sidebar)
    corner(btn, 5)
    buttons[tab] = btn

    btn.Activated:Connect(function()
        renderTab(tab)
    end)
end

