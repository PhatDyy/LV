local function makePage(name)
    local page = make("ScrollingFrame", {
        Name = name,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.gold,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, content)

    make("UIPadding", {
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 9),
        PaddingRight = UDim.new(0, 9),
    }, page)

    make("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)

    pages[name] = page
    return page
end

local function switchTab(name)
    currentTab = name

    for tabName, page in pairs(pages) do
        page.Visible = tabName == name
    end

    for tabName, button in pairs(tabButtons) do
        button.BackgroundColor3 =
            tabName == name and C.gold or C.item

        button.TextColor3 =
            tabName == name and C.bg or C.white
    end
end

local function addLabel(page, text)
    return make("TextLabel", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = C.gold,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
    }, page)
end

local function addButton(page, text, callback)
    local button = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 39),
        BackgroundColor3 = C.item,
        TextColor3 = C.white,
        Text = text,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextWrapped = true,
        AutoButtonColor = true,
    }, page)

    round(button, 7)

    button.Activated:Connect(function()
        local ok, err = pcall(callback, button)
        if not ok then
            warn("[LV Hub] " .. tostring(err))
        end
    end)

    return button
end

local function addToggle(page, text, initial, callback)
    local enabled = initial
    local button

    local function refresh()
        button.Text = text .. "  [" ..
            (enabled and "ON" or "OFF") .. "]"

        button.TextColor3 = enabled and C.gold or C.white
    end

    button = addButton(page, text, function()
        enabled = not enabled
        refresh()
        callback(enabled)
    end)

    refresh()
    return button
end

local function addStepper(page, text, minimum, maximum, initial, callback)
    local value = initial

    local row = make("Frame", {
        Size = UDim2.new(1, 0, 0, 62),
        BackgroundColor3 = C.item,
        BorderSizePixel = 0,
    }, page)
    round(row, 7)

    local label = make("TextLabel", {
        Size = UDim2.new(1, -92, 1, 0),
        Position = UDim2.fromOffset(8, 0),
        BackgroundTransparency = 1,
        Text = text .. ": " .. value,
        TextColor3 = C.white,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
    }, row)

    local minus = make("TextButton", {
        Size = UDim2.fromOffset(32, 30),
        Position = UDim2.new(1, -72, 0.5, -15),
        Text = "−",
        TextColor3 = C.gold,
        BackgroundColor3 = C.bg,
        TextSize = 18,
    }, row)
    round(minus, 6)

    local plus = make("TextButton", {
        Size = UDim2.fromOffset(32, 30),
        Position = UDim2.new(1, -36, 0.5, -15),
        Text = "+",
        TextColor3 = C.gold,
        BackgroundColor3 = C.bg,
        TextSize = 18,
    }, row)
    round(plus, 6)

    local function update(delta)
        value = math.clamp(value + delta, minimum, maximum)
        label.Text = text .. ": " .. value
        callback(value)
    end

    minus.Activated:Connect(function() update(-1) end)
    plus.Activated:Connect(function() update(1) end)

    return function(newValue)
        value = math.clamp(newValue, minimum, maximum)
        label.Text = text .. ": " .. value
        callback(value)
    end
end

