-- ======================================================
-- LOGIC VÒNG LẶP HỆ THỐNG (BACKGROUND LOOPS)
-- ======================================================

local VirtualUser = game:GetService("VirtualUser")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Vòng lặp Auto Click
task.spawn(function()
    while task.wait(0.1) do
        if _G.AutoClick or _G.AutoFarm then
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton1(Vector2.new(0, 0))
            end)
        end
    end
end)

-- Vòng lặp Gom Quái (Bring Mob)
task.spawn(function()
    while task.wait(0.2) do
        if _G.BringMob and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                local myPos = LocalPlayer.Character.HumanoidRootPart.Position
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                        if (enemy.HumanoidRootPart.Position - myPos).Magnitude < 350 then
                            enemy.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5)
                            enemy.HumanoidRootPart.CanCollide = false
                        end
                    end
                end
            end)
        end
    end
end)

-- Vòng lặp ESP Trái Ác Quỷ
task.spawn(function()
    while task.wait(2) do
        if _G.FruitESP then
            pcall(function()
                for _, obj in pairs(workspace:GetChildren()) do
                    if obj:IsA("Tool") or string.find(obj.Name, "Fruit") then
                        if not obj:FindFirstChild("FruitHighlight") then
                            local highlight = Instance.new("Highlight")
                            highlight.Name = "FruitHighlight"
                            highlight.FillColor = Color3.fromRGB(255, 0, 0)
                            highlight.Parent = obj
                        end
                    end
                end
            end)
        end
    end
end)

