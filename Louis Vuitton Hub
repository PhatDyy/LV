local function EquipWeapon()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                if _G.SelectWeapon == "Melee" and tool.ToolTip == "Melee" then
                    char.Humanoid:EquipTool(tool)
                elseif _G.SelectWeapon == "Sword" and tool.ToolTip == "Sword" then
                    char.Humanoid:EquipTool(tool)
                elseif _G.SelectWeapon == "Blox Fruit" and tool.ToolTip == "Blox Fruit" then
                    char.Humanoid:EquipTool(tool)
                end
            end
        end
    end)
end

