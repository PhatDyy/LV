-- STATS
do
    local p = pageFrames["Stats"]
    heading(p, "CHARACTER STATS")
    label(p, "Displays only information exposed by the game client.")
    local container = create("Frame", {
        Size = UDim2.new(1, -4, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1
    }, p)
    create("UIListLayout", {
        Padding = UDim.new(0, 5)
    }, container)

    button(p, "Read Available Stats", function()
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("TextLabel") then child:Destroy() end
        end

        local ls = player:FindFirstChild("leaderstats")
        if not ls then
            label(container, "No public leaderstats found.")
            return
        end

        for _, stat in ipairs(ls:GetChildren()) do
            if stat:IsA("ValueBase") then
                label(container, stat.Name .. ": " .. tostring(stat.Value))
            end
        end
    end)
end

