local Players = game:GetService("Players")

local MAX_RANGE = 150

local function getValidTarget(
    shooter,
    targetCharacter
)
    if not targetCharacter then
        return nil
    end

    local shooterCharacter = shooter.Character
    if not shooterCharacter then
        return nil
    end

    local shooterRoot =
        shooterCharacter:FindFirstChild("HumanoidRootPart")

    local targetRoot =
        targetCharacter:FindFirstChild("HumanoidRootPart")

    local targetHumanoid =
        targetCharacter:FindFirstChildOfClass("Humanoid")

    if not shooterRoot
        or not targetRoot
        or not targetHumanoid
        or targetHumanoid.Health <= 0 then
        return nil
    end

    if targetCharacter == shooterCharacter then
        return nil
    end

    local targetPlayer =
        Players:GetPlayerFromCharacter(targetCharacter)

    if targetPlayer and targetPlayer == shooter then
        return nil
    end

    local distance =
        (targetRoot.Position - shooterRoot.Position).Magnitude

    if distance > MAX_RANGE then
        return nil
    end

    return targetRoot
end

