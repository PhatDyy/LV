    local p = pageFrames["Items"]
    heading(p, "ITEM TRACKER")
    label(p, "Use this page to plan which items to collect.")
    local itemInput = create("TextBox", {
        Size = UDim2.new(1, -4, 0, 36),
        BackgroundColor3 = DARK,
        BorderSizePixel = 0,
        Text = "",
        PlaceholderText = "Enter item / material name...",
        PlaceholderColor3 = GRAY,
        TextColor3 = WHITE,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        ClearTextOnFocus = false
    }, p)
    create("UICorner", {CornerRadius = UDim.new(0, 7)}, itemInput)

    local itemList = {}
    local itemContainer = create("Frame", {
        Size = UDim2.new(1, -4, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1
    }, p)
    create("UIListLayout", {
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, itemContainer)

    button(p, "Add Item to Tracker", function()
        local name = itemInput.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" then return end
        table.insert(itemList, name)
        label(itemContainer, "• " .. name, 28)
        itemInput.Text = ""
    end)
