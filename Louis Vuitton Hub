-- 4. LOGIC TỰ ĐỘNG SĂN BOSS & LẤY VŨ KHÍ
--------------------------------------------------------
local LocalPlayer = Players.LocalPlayer

-- Loop Auto Yama & Pull
task.spawn(function()
    while task.wait(1) do
        if _G.AutoYama and LocalPlayer.Character then
            pcall(function()
                -- Dịch chuyển đến đền thờ Yama ở Hydra Island và tương tác
                local yamaLocation = CFrame.new(-5256, 15, 836)
                if (LocalPlayer.Character.HumanoidRootPart.Position - yamaLocation.Position).Magnitude > 20 then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = yamaLocation
                else
                    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("PullYama")
                end
            end)
        end
    end
end)

-- Loop Auto Farm Boss
task.spawn(function()
    while task.wait(0.2) do
        if _G.AutoFarmBoss and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                for _, boss in pairs(workspace.Enemies:GetChildren()) do
                    if boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0 and boss:FindFirstChild("HumanoidRootPart") then
                        if boss.Humanoid.MaxHealth > 100000 then -- Nhận diện là Boss
                            LocalPlayer.Character.HumanoidRootPart.CFrame = boss.HumanoidRootPart.CFrame * CFrame.new(0, 8, 0)
                            break
                        end
                    end
                end
            end)
        end
    end
end)

-- Loop Fast Attack
task.spawn(function()
    while task.wait(0.005) do
        if (_G.AutoFarmLv or _G.AutoSecretLevel or _G.AutoElite or _G.AutoFarmBoss or _G.AutoYama or _G.AutoTushita or _G.AutoCDK) and _G.FastAttack then
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
            end)
        end
    end
end)

-- Bật Noclip liên tục
game:GetService("RunService").Stepped:Connect(function()
    if (_G.AutoFarmLv or _G.AutoSecretLevel or _G.AutoElite or _G.AutoFarmBoss or _G.AutoCDK) and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

