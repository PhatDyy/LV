local Workspace = game:GetService("Workspace")

local NPC_FOLDER = Workspace:WaitForChild("FarmNPCs")
local FARM_POSITION = Vector3.new(0, 5, 0)

local function getAliveNPC()
    for _, npc in ipairs(NPC_FOLDER:GetChildren()) do
        local humanoid = npc:FindFirstChildOfClass("Humanoid")
        local root = npc:FindFirstChild("HumanoidRootPart")

        if humanoid and root and humanoid.Health > 0 then
            return npc, humanoid, root
        end
    end

    return nil
end

while true do
    local npc, humanoid, root = getAliveNPC()

    if npc then
        root.CFrame = CFrame.new(FARM_POSITION)

        print("NPC sẵn sàng farm:", npc.Name)

        humanoid.Died:Once(function()
            print("NPC đã bị hạ:", npc.Name)
        end)
    end

    task.wait(2)
end
