local pages = {}
local selectedPage

local function makePage(name)
    local page = create("Frame", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Visible = false,
    }, content)

    create("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)

    pages[name] = page
    return page
end

local function switchPage(name)
    selectedPage = name

    for pageName, page in pairs(pages) do
        page.Visible = pageName == name
    end

    for _, button in ipairs(sidebar:GetChildren()) do
        if button:IsA("TextButton") then
            button.BackgroundColor3 =
                button.Name == name and gold or panel

            button.TextColor3 =
                button.Name == name and bg or white
        end
    end
end

local function addButton(page, label, callback)
    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = bg,
        TextColor3 = white,
        Text = label,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = true,
    }, page)

    create("UICorner", {CornerRadius = UDim.new(0, 7)}, button)

    button.Activated:Connect(callback)
    return button
end

local function addToggle(page, label, default, callback)
    local enabled = default

    local button = addButton(
        page,
        label .. "  [" .. (enabled and "ON" or "OFF") .. "]",
        function()
            enabled = not enabled
            button.Text = label .. "  [" ..
                (enabled and "ON" or "OFF") .. "]"
            callback(enabled)
        end
    )

    return button
end

local function addSlider(page, label, minimum, maximum, initial, callback)
    local value = initial

    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 62),
        BackgroundColor3 = bg,
        BorderSizePixel = 0,
    }, page)

    create("UICorner", {CornerRadius = UDim.new(0, 7)}, row)

    local title = create("TextLabel", {
        Size = UDim2.new(1, -12, 0, 25),
        Position = UDim2.new(0, 6, 0, 2),
        BackgroundTransparency = 1,
        Text = label .. ": " .. value,
        TextColor3 = white,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local minus = create("TextButton", {
        Position = UDim2.new(0, 6, 0, 31),
        Size = UDim2.fromOffset(38, 25),
        Text = "-",
        TextSize = 18,
        BackgroundColor3 = panel,
        TextColor3 = gold,
    }, row)

    local plus = create("TextButton", {
        Position = UDim2.new(1, -44, 0, 31),
        Size = UDim2.fromOffset(38, 25),
        Text = "+",
        TextSize = 18,
        BackgroundColor3 = panel,
        TextColor3 = gold,
    }, row)

    create("UICorner", {CornerRadius = UDim.new(0, 6)}, minus)
    create("UICorner", {CornerRadius = UDim.new(0, 6)}, plus)

    local function update(delta)
        value = math.clamp(value + delta, minimum, maximum)
        title.Text = label .. ": " .. value
        callback(value)
    end

    minus.Activated:Connect(function() update(-1) end)
    plus.Activated:Connect(function() update(1) end)
end

