                    local mouseDist = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(screenPoint.X, screenPoint.Y)).Magnitude
                    if mouseDist < shortestDist then
                        shortestDist = mouseDist
                        target = player.Character.HumanoidRootPart
                    end
                end
            end
        end
    end
    return target
end

