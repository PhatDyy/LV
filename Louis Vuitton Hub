end

local function heading(text)
    local label = create("TextLabel", {
        Size = UDim2.new(1, -3, 0, 25),
        BackgroundTransparency = 1,
        Text = string.upper(text),
        TextColor3 = theme.yellow,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, page)
    label:SetAttribute("SearchText", text:lower())
end

local function addCard(name, desc)
    local frame = create("Frame", {
        Size = UDim2.new(1, -3, 0, desc and 59 or 45),
        BackgroundColor3 = theme.card,
        BorderSizePixel = 0,
    }, page)
    round(frame, 8)

    create("TextLabel", {
        Position = UDim2.fromOffset(10, desc and 5 or 0),
        Size = UDim2.new(1, -95, 0, 25),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = theme.white,
        Font = Enum.Font.GothamSemibold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, frame)

    if desc then
        create("TextLabel", {
            Position = UDim2.fromOffset(10, 29),
            Size = UDim2.new(1, -16, 0, 22),
            BackgroundTransparency = 1,
            Text = desc,
            TextColor3 = theme.gray,
            Font = Enum.Font.Gotham,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, frame)
    end

    frame:SetAttribute("SearchText", (name .. " " .. (desc or "")):lower())
    return frame
end

local function addToggle(name, initial, callback, desc)
    local frame = addCard(name, desc)
    local enabled = initial == true

    local b = button(
        frame,
        enabled and "ON" or "OFF",
        UDim2.fromOffset(48, 27),
        UDim2.new(1, -55, 0.5, -13),
        enabled and theme.green or theme.panel
    )

    b.Activated:Connect(function()
        enabled = not enabled
        b.Text = enabled and "ON" or "OFF"
        animate(b, {
            BackgroundColor3 = enabled and theme.green or theme.panel
        })
        if callback then
            callback(enabled)
        end
    end)
end

local function addAction(name, callback, desc)
    local frame = addCard(name, desc)
    local b = button(
        frame, "RUN",
        UDim2.fromOffset(48, 27),
        UDim2.new(1, -55, 0.5, -13),
        theme.yellow
    )
    b.TextColor3 = theme.bg

    b.Activated:Connect(function()
        local ok, err = pcall(callback or function() end)
        if not ok then warn(err) end
        animate(b, {BackgroundColor3 = theme.green})
        task.delay(0.3, function()
            if b.Parent then
                animate(b, {BackgroundColor3 = theme.yellow})
            end
        end)
    end)
end

local function addSlider(name, minValue, maxValue, initial, callback)
    local frame = addCard(name)
    frame.Size = UDim2.new(1, -3, 0, 70)

    local valueLabel = create("TextLabel", {
        Position = UDim2.new(1, -65, 0, 3),
        Size = UDim2.fromOffset(55, 22),
        BackgroundTransparency = 1,
        Text = tostring(initial),
        TextColor3 = theme.yellow,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
    }, frame)

    local track = create("Frame", {
        Position = UDim2.new(0, 10, 0, 43),
        Size = UDim2.new(1, -20, 0, 7),
        BackgroundColor3 = theme.panel,
        BorderSizePixel = 0,
    }, frame)
    round(track, 5)

    local ratio = (initial - minValue) / (maxValue - minValue)
    local fill = create("Frame", {
        Size = UDim2.new(ratio, 0, 1, 0),
        BackgroundColor3 = theme.yellow,
        BorderSizePixel = 0,
    }, track)
    round(fill, 5)

    local knob = create("TextButton", {
        Position = UDim2.new(ratio, -8, 0.5, -8),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = theme.white,
        Text = "",
    }, track)
    round(knob, 10)

    local function setValue(value)
        value = math.clamp(
            math.floor(value + 0.5), minValue, maxValue
        )
        ratio = (value - minValue) / (maxValue - minValue)
        valueLabel.Text = tostring(value)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, -8, 0.5, -8)
        if callback then callback(value) end
    end

    local function move(input)
        local width = math.max(track.AbsoluteSize.X, 1)
        local x = math.clamp(
            (input.Position.X - track.AbsolutePosition.X) / width,
            0, 1
        )
        setValue(minValue + x * (maxValue - minValue))
    end

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            move(input)
        end
    end)

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            move(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseMovement then
            if UserInputService:IsMouseButtonPressed(
                Enum.UserInputType.MouseButton1
            ) then
                move(input)
            end
        end
    end)
end

local function render(tab)
    clearPage()

    if tab == "Home" then
        heading("Dashboard")
        addCard("Welcome", "Banana Upgrade GUI")
        addCard("Player", player.Name)
        addCard("Platform", "Touch / Keyboard supported")
        addAction("Refresh dashboard", function()
            render("Home")
        end, "Refresh this page")

    elseif tab == "Player" then
        heading("Character settings")
        addSlider("WalkSpeed", 8, 32, 16, function(value)
            -- Display/test value only; apply on your own game's
            -- server-authorized character controller.
            player:SetAttribute("UITestWalkSpeed", value)
        end)
        addSlider("JumpPower", 20, 100, 50, function(value)
            player:SetAttribute("UITestJumpPower", value)
        end)
        addAction("Reset character", function()
            player:LoadCharacter()
        end, "Respawn your character")

    elseif tab == "Visuals" then
        heading("Visual settings")
        addToggle("Show FPS counter", true, function(enabled)
            state.showFPS = enabled
        end)
        addToggle("Highlight test objects", false, function(enabled)
            state.highlights = enabled
        end, "Toggle visual demo state")
        addToggle("Lighting blur", false, function(enabled)
            local blur = game.Lighting:FindFirstChild("BananaBlur")
            if enabled and not blur then
                blur = Instance.new("BlurEffect")
                blur.Name = "BananaBlur"
                blur.Size = 5
                blur.Parent = Lighting
            elseif not enabled and blur then
                blur:Destroy()
            end
        end)

    elseif tab == "Teleport" then
        heading("Position tools")
        addAction("Save position", function()
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                state.savedPosition = root.CFrame
            end
        end, "Save your current position")
        addAction("Return to saved position", function()
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root and state.savedPosition then
                root.CFrame = state.savedPosition
            end
        end, "Local demo for your own game")

    elseif tab == "Training" then
        heading("Training tools")
        addCard("Damage test", "Connect to your own test dummy")
        addCard("Quest test", "Connect to your own quest system")
        addCard("Fruit test", "Connect to your own inventory system")
        addAction("Reset test counters", function()
            player:SetAttribute("TestDamage", 0)
            player:SetAttribute("TestXP", 0)
        end)

    elseif tab == "Settings" then
        heading("Interface settings")
        addToggle("Compact mode", state.compact, function(enabled)
            state.compact = enabled
            main.Size = enabled
                and UDim2.fromOffset(540, 65)
                or UDim2.fromOffset(540, 410)
            sidebar.Visible = not enabled
            area.Visible = not enabled
        end)
        addToggle("Dark theme", true, function(enabled)
            state.dark = enabled
            main.BackgroundColor3 = enabled
                and theme.bg
                or Color3.fromRGB(235, 238, 245)
            if not enabled then
                title.TextColor3 = Color3.fromRGB(150, 100, 0)
            else
                title.TextColor3 = theme.yellow
            end
        end)
        addAction("Reset UI", function()
            main.Position = UDim2.new(0.5, -270, 0.5, -205)
            main.Size = UDim2.fromOffset(540, 410)
            sidebar.Visible = true
            area.Visible = true
            state.compact = false
        end)
    end

    local query = search.Text:lower()
    for _, obj in ipairs(page:GetChildren()) do
        if obj:IsA("GuiObject") and obj ~= list then
            local key = obj:GetAttribute("SearchText")
            if query ~= "" then
                obj.Visible = key ~= nil and key:find(query, 1, true) ~= nil
            else
                obj.Visible = true
            end
        end
    end
end

local tabs = {
    "Home", "Player", "Visuals",
    "Teleport", "Training", "Settings"
}

for index, name in ipairs(tabs) do
    local b = button(
        sidebar,
        name,
        UDim2.new(1, 0, 0, 37),
        UDim2.new(),
        theme.card
    )
    b.LayoutOrder = index

    b.Activated:Connect(function()
        for _, other in ipairs(sidebar:GetChildren()) do
            if other:IsA("TextButton") then
                animate(other, {BackgroundColor3 = theme.card})
            end
        end
        animate(b, {BackgroundColor3 = theme.yellow})
        b.TextColor3 = theme.bg
        currentTab = name
        render(name)
    end)
end

search:GetPropertyChangedSignal("Text"):Connect(function()
    local query = search.Text:lower()
    for _, obj in ipairs(page:GetChildren()) do
        if obj:IsA("GuiObject") and obj ~= list then
            local key = obj:GetAttribute("SearchText")
            obj.Visible = query == "" or (
                key ~= nil and key:find(query, 1, true) ~= nil
            )
        end
    end
end)

minimize.Activated:Connect(function()
    local hidden = not sidebar.Visible
    sidebar.Visible = hidden
    area.Visible = hidden
    main.Size = hidden
        and UDim2.fromOffset(260, 48)
        or UDim2.fromOffset(540, 410)
end)

-- Drag with mouse or touchscreen
local dragging = false
local dragInput
local dragStart
local startPosition

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

render("Home")
print("Banana Upgrade GUI loaded")
