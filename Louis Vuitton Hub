-- 4. BỘ XỬ LÝ FARM & ĐÁNH MỚI (FIXED BACKEND LOGIC)
--------------------------------------------------------
local LocalPlayer = Players.LocalPlayer

-- Trang bị vũ khí
local function EquipWeapon()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
            if tool:IsA("Tool") then
                if _G.SelectWeapon == "Melee" and tool.ToolTip == "Melee" then
                    char.Humanoid:EquipTool(tool)
                elseif _G.SelectWeapon == "Sword" and tool.ToolTip == "Sword" then
                    char.Humanoid:EquipTool(tool)
                elseif _G.SelectWeapon == "Blox Fruit" and tool.ToolTip == "Blox Fruit" then
                    char.Humanoid:EquipTool(tool)
                end
            end
        end
    end)
end

-- Vòng lặp Đánh & Fast Attack
task.spawn(function()
    while task.wait(0.01) do
        if _G.AutoFarmLv or _G.AutoSecretLevel or _G.AutoElite or _G.AutoFarmBoss or _G.AutoClick then
            pcall(function()
                EquipWeapon()
                local char = LocalPlayer.Character
                if char and char:FindFirstChildOfClass("Tool") then
                    char:FindFirstChildOfClass("Tool"):Activate()
                end
            end)
        end
    end
end)

-- Vòng lặp Auto Farm Level
task.spawn(function()
    while task.wait(0.05) do
        if (_G.AutoFarmLv or _G.AutoSecretLevel) and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                local hrp = LocalPlayer.Character.HumanoidRootPart
                local targetMob = nil
                local shortestDistance = math.huge

                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                        local dist = (enemy.HumanoidRootPart.Position - hrp.Position).Magnitude
                        if dist < shortestDistance then
                            shortestDistance = dist
                            targetMob = enemy
                        end
                    end
                end

                if targetMob then
                    local offsetHeight = _G.AutoSecretLevel and 6.5 or 7.5
                    hrp.CFrame = targetMob.HumanoidRootPart.CFrame * CFrame.new(0, offsetHeight, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                end
            end)
        end
    end
end)

-- Gom Quái (Bring Mobs)
task.spawn(function()
    while task.wait(0.1) do
        if _G.BringMob and (_G.AutoFarmLv or _G.AutoSecretLevel) and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                local myPos = LocalPlayer.Character.HumanoidRootPart.Position
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                        if (enemy.HumanoidRootPart.Position - myPos).Magnitude < 250 then
                            enemy.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, -2, -3)
                            enemy.HumanoidRootPart.CanCollide = false
                        end
                    end
                end
            end)
        end
    end
end)

-- Bật Noclip
game:GetService("RunService").Stepped:Connect(function()
    if (_G.AutoFarmLv or _G.AutoSecretLevel or _G.AutoElite or _G.AutoFarmBoss) and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

