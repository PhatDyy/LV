end)

local function GetPlayerLevel()
    local lvl = 1
    pcall(function()
        if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level") then
            lvl = LocalPlayer.Data.Level.Value
        elseif LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Level") then
            lvl = LocalPlayer.leaderstats.Level.Value
        end
    end)
    return lvl
end

-- Loop Auto Farm Level (Fix chiều cao bay lên đầu quái + chống rung)
task.spawn(function()
    while task.wait(0.1) do
        if (_G.AutoFarmLv or _G.AutoSecretLevel) and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            pcall(function()
                local hrp = LocalPlayer.Character.HumanoidRootPart
                local pLevel = GetPlayerLevel()
                local targetMob = nil
                local shortestDistance = math.huge

                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                        local enemyName = enemy.Name
                        local skip = false
                        
                        if pLevel > 2000 then
                            if string.find(enemyName, "Bandit") or string.find(enemyName, "Monkey") or string.find(enemyName, "Gorilla") or string.find(enemyName, "Pirate") or string.find(enemyName, "Desert") or string.find(enemyName, "Snow") then
                                skip = true
                            end
                        end

                        if not skip then
                            local dist = (enemy.HumanoidRootPart.Position - hrp.Position).Magnitude
                            if dist < shortestDistance then
                                shortestDistance = dist
                                targetMob = enemy
                            end
                        end
                    end
                end

                if targetMob then
                    -- Đặt chiều cao đứng trên đầu quái hoàn hảo (10 units)
                    local offsetHeight = _G.AutoSecretLevel and 9.0 or 10.5
                    local targetCFrame = targetMob.HumanoidRootPart.CFrame * CFrame.new(0, offsetHeight, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                    
                    if (hrp.Position - targetCFrame.Position).Magnitude > 15 then
                        TweenTo(targetCFrame)
                    else
                        hrp.CFrame = targetCFrame
                    end
                end
            end)
        end
    end
end)

