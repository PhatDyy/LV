
local Players = game:GetService("Players")

local function eliminatePlayer(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target or not target.Character then
        return false, "Không tìm thấy người chơi"
    end

    local humanoid =
        target.Character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health <= 0 then
        return false, "Nhân vật không hợp lệ hoặc đã bị hạ"
    end

    humanoid.Health = 0
    return true, "Đã hạ người chơi trong game thử nghiệm"
end

