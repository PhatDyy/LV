local function createPage(name)
    local page = new("ScrollingFrame", {
        Name = name,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = GOLD,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, content)

    new("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)

    new("UIPadding", {
        PaddingRight = UDim.new(0, 5),
        PaddingBottom = UDim.new(0, 8),
    }, page)

    pages[name] = page
    return page
end

local function makeTab(name, iconText)
    local b = new("TextButton", {
        Name = name .. "Tab",
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = PANEL2,
        Text = iconText .. "  " .. name,
        TextColor3 = WHITE,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        AutoButtonColor = true,
    }, sidebar)
    corner(b, 7)

    local page = createPage(name)
    tabButtons[name] = b

    b.Activated:Connect(function()
        showPage(name)
    end)

    return page
end

showPage = function(name)
    currentPage = name
    for pageName, page in pairs(pages) do
        page.Visible = pageName == name
    end

    for tabName, button in pairs(tabButtons) do
        button.BackgroundColor3 =
            tabName == name and Color3.fromRGB(74, 59, 27) or PANEL2
        button.TextColor3 = tabName == name and GOLD or WHITE
    end
end

local function section(parent, text)
    return new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 25),
        BackgroundTransparency = 1,
        Text = string.upper(text),
        TextColor3 = GOLD,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
end

local function info(parent, text, height)
    return new("TextLabel", {
        Size = UDim2.new(1, 0, 0, height or 35),
        BackgroundColor3 = PANEL,
        Text = text,
        TextColor3 = MUTED,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
end

local function button(parent, text, callback)
    local b = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundColor3 = PANEL2,
        Text = text,
        TextColor3 = WHITE,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        AutoButtonColor = true,
    }, parent)
    corner(b, 7)
    stroke(b, Color3.fromRGB(65, 65, 73), 1)

    b.Activated:Connect(callback)
    return b
end

local function valueRow(parent, labelText, initialText, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
    }, parent)
    corner(row, 7)

    new("TextLabel", {
        Position = UDim2.new(0, 9, 0, 0),
        Size = UDim2.new(0.53, -9, 1, 0),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = WHITE,
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local value = new("TextLabel", {
        Position = UDim2.new(0.53, 0, 0, 0),
        Size = UDim2.new(0.47, -6, 1, 0),
        BackgroundTransparency = 1,
        Text = initialText,
        TextColor3 = GOLD,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)

    if callback then
        callback(value)
    end

    return value
end

-- Character helpers
local function getCharacter()
    return player.Character
end

local function getHumanoid()
    local char = getCharacter()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local char = getCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local settings = {
    walkSpeed = 16,
    jumpPower = 50,
    fov = 70,
    fullBright = false,
}

local originalLighting = {
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    GlobalShadows = Lighting.GlobalShadows,
    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient,
}

local function applyMovement()
    local hum = getHumanoid()
    if not hum then return end

    hum.WalkSpeed = settings.walkSpeed
    hum.UseJumpPower = true
    hum.JumpPower = settings.jumpPower
end

local function applyFov()
    local camera = workspace.CurrentCamera
    if camera then
        camera.FieldOfView = settings.fov
    end
end

local function setFullBright(enabled)
    settings.fullBright = enabled

    if enabled then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(200, 200, 200)
        Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
    else
        for property, value in pairs(originalLighting) do
            Lighting[property] = value
        end
    end
end

