local function applyMovement()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.WalkSpeed = config.Speed
        humanoid.UseJumpPower = true
        humanoid.JumpPower = config.Jump
    end
end

addSlider(movement, "Walk Speed", 8, 32, 16, function(value)
    config.Speed = value
    applyMovement()
end)

addSlider(movement, "Jump Power", 25, 80, 50, function(value)
    config.Jump = value
    applyMovement()
end)

addButton(movement, "Reset movement", function()
    config.Speed = 16
    config.Jump = 50
    applyMovement()
end)

addToggle(visual, "Gold lighting effect", false, function(enabled)
    local effect = Lighting:FindFirstChild("LVHubEffect")

    if enabled and not effect then
        effect = Instance.new("ColorCorrectionEffect")
        effect.Name = "LVHubEffect"
        effect.TintColor = Color3.fromRGB(255, 240, 210)
        effect.Parent = Lighting
    elseif not enabled and effect then
        effect:Destroy()
    end
end)

addToggle(visual, "Bloom effect", false, function(enabled)
    local effect = Lighting:FindFirstChild("LVHubBloom")

    if enabled and not effect then
        effect = Instance.new("BloomEffect")
        effect.Name = "LVHubBloom"
        effect.Intensity = 0.25
        effect.Size = 18
        effect.Parent = Lighting
    elseif not enabled and effect then
