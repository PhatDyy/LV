addToggle(visuals, "Fullbright", false, function(enabled)
    state.fullbright = enabled

    if enabled then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.Ambient = Color3.fromRGB(200, 200, 200)
        Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
    else
        Lighting.Brightness = originalLighting.Brightness
        Lighting.ClockTime = originalLighting.ClockTime
        Lighting.Ambient = originalLighting.Ambient
        Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
    end
end)

addToggle(visuals, "Gold color effect", false, function(enabled)
    state.goldLight = enabled
    local effect = Lighting:FindFirstChild("LVGoldEffect")

    if enabled and not effect then
        effect = Instance.new("ColorCorrectionEffect")
        effect.Name = "LVGoldEffect"
        effect.TintColor = Color3.fromRGB(255, 239, 205)
        effect.Saturation = -0.05
        effect.Parent = Lighting
    elseif not enabled and effect then
        effect:Destroy()
    end
end)

addToggle(visuals, "Bloom effect", false, function(enabled)
    state.bloom = enabled
    local effect = Lighting:FindFirstChild("LVBloom")

    if enabled and not effect then
        effect = Instance.new("BloomEffect")
        effect.Name = "LVBloom"
        effect.Intensity = 0.3
        effect.Size = 18
        effect.Threshold = 1.2
        effect.Parent = Lighting
    elseif not enabled and effect then
